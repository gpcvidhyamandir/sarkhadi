rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "Nwml4LiQZqeuDlfHBFyzkPIURvy2"
        ];
    }
    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notices/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /events/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /admissionEnquiries/{id} {
      allow create: if request.resource.data.keys().hasAll(['parentName','studentName','mobile','admissionClass'])
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^[0-9]{10}$');
      allow read, update, delete: if isAdmin();
    }
  }
}
